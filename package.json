{
  "name": "@birbprophet/untitled-ui-foldkit",
  "version": "0.0.0",
  "description": "Verified Untitled UI v8 components ported to FoldKit. Brand-neutral renderers; consumers inject theme and identity at the host boundary.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "src",
    "default-brand.css",
    "theme.css",
    "catalog-reconciliation.json"
  ],
  "type": "module",
  "exports": {
    "./application": "./src/application.ts",
    "./base": "./src/base.ts",
    "./brand-context": "./src/brand-context.ts",
    "./catalog": "./src/catalog.ts",
    "./marketing": "./src/marketing.ts",
    "./theme": "./src/theme.ts",
    "./theme.css": "./theme.css",
    "./package.json": "./package.json",
    "./application/*": "./src/application/*",
    "./base/*": "./src/base/*",
    "./marketing/*": "./src/marketing/*",
    "./internal/*": "./src/internal/*"
  },
  "scripts": {
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112",
    "foldkit": "0.157.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@foldkit/oxlint-plugin": "0.12.0",
    "@foldkit/vite-plugin": "0.20.1",
    "@mpsuesser/oxlint-plugin-effect": "0.4.3",
    "@rikalabs/oxlint-standards": "0.8.1",
    "@storybook/html-vite": "10.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.3.0",
    "blobatar": "2.5.0",
    "oxlint": "1.79.0",
    "oxlint-plugin": "workspace:*",
    "storybook": "10.5.10",
    "storybook-renderer-foldkit": "github:birbprophet/storybook-renderer-foldkit#c1874b029184853bd2a5f0087c7fd32cc71c3e8d",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.10.6",
    "untitledui": "0.1.64",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "peerDependencies": {
    "avatar": "*",
    "brand": "*",
    "tokens": "*"
  },
  "overrides": {
    "@effect/vitest": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "foldkit": "0.157.0",
    "oxlint": "1.79.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  }
}
